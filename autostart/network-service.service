# systemd Service Template für einen Netzwerkdienst
# Tutorial: https://raspberry.tips/raspberrypi-einsteiger/raspberry-pi-autostart-von-skripten-und-programmen-einrichten
# Speichern unter: /etc/systemd/system/mein-dienst.service
# "benutzer" durch euren Benutzernamen ersetzen (whoami)

[Unit]
Description=Mein Netzwerkdienst
Wants=network-online.target
After=network-online.target
# Neustart bei zu vielen Abstürzen verhindern (gehört in [Unit], nicht in [Service]):
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=benutzer
ExecStart=/usr/local/bin/mein-dienst
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
